<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MdTest</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <!-- MarkupString lives in the ASP.NET Core shared framework -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="AngleSharp" Version="1.5.2" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <!-- The real service files from the app, not copies -->
    <Compile Include="..\MDViewer.Core\Services\MarkdownRenderer.cs" />
    <Compile Include="..\MDViewer.Core\Services\EpubGenerator.cs" />
    <Compile Include="..\MDViewer.Core\Services\EpubDocument.cs" />
    <Compile Include="..\MDViewer.Core\Services\EpubHtml.cs" />
    <Compile Include="..\MDViewer.Core\Services\ReadingPositions.cs" />
    <Compile Include="..\MDViewer.Core\Services\WordExporter.cs" />
    <Compile Include="..\MDViewer.Core\Services\ExportPaths.cs" />
    <Compile Include="..\MDViewer.Core\Services\MarkdownFile.cs" />
    <Compile Include="..\MDViewer.Core\Services\HtmlToMarkdown.cs" />
  </ItemGroup>

</Project>
