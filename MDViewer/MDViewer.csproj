<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>

        <OutputType>Exe</OutputType>
        <RootNamespace>MDViewer</RootNamespace>
        <AssemblyName>MDViewer</AssemblyName>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <EnableDefaultCssItems>false</EnableDefaultCssItems>
        <Nullable>enable</Nullable>
        <MauiXamlInflator>SourceGen</MauiXamlInflator>

        <!-- Display name -->
        <ApplicationTitle>Markdown Viewer</ApplicationTitle>

        <!-- App Identifier -->
        <ApplicationId>nz.pontifex.mdviewer</ApplicationId>

        <!-- Versions -->
        <!-- Package version is ApplicationDisplayVersion with ApplicationVersion as the
             fourth part: 1.0.5 + 0 -> 1.0.5.0. The Microsoft Store reserves that fourth
             part and requires it to be 0 on submission, so the release counter lives in
             ApplicationDisplayVersion. Bump the third digit for each release. -->
        <ApplicationDisplayVersion>1.0.5</ApplicationDisplayVersion>
        <ApplicationVersion>0</ApplicationVersion>

        <!-- Debug F5 deploys share this package identity with the installed release,
             so a Debug build at or below the release version makes Visual Studio
             prompt to uninstall the release on every run. 9999 keeps Debug sorting
             above any real release (the revision field maxes out at 65535), so F5
             is a silent upgrade. It does NOT let the two coexist — same identity,
             so a Debug deploy still replaces the installed release, and installing
             a release afterwards is a downgrade: remove the package first, as the
             Install section of the README says. -->
        <ApplicationVersion Condition="'$(Configuration)' == 'Debug'">9999</ApplicationVersion>

        <!-- Packaged (MSIX). The .md file association in Package.appxmanifest is only
             honoured for a packaged app, so WindowsPackageType is deliberately NOT set
             to None here (unset = packaged).
             For a quick unpackaged dev run that skips install/cert entirely:
               dotnet build -t:Run -p:WindowsPackageType=None -->
        <EnableMsixTooling>true</EnableMsixTooling>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>

        <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
        <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    </PropertyGroup>

    <ItemGroup>
        <!-- App Icon -->
        <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#2B579A" />

        <!-- Splash Screen -->
        <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#2B579A" BaseSize="128,128" />

        <!-- Custom Fonts -->
        <MauiFont Include="Resources\Fonts\*" />

        <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
        <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />

        <!-- Same versions as our internal knowledge base, so rendering and ePub
             output behave identically -->
        <PackageReference Include="Markdig" Version="1.3.2" />
        <PackageReference Include="AngleSharp" Version="1.5.2" />
    </ItemGroup>

    <!-- Workaround for a bug in the installed maui-windows workload (10.0.20):
         ConvertStaticWebAssetsToMauiAssets computes the Blazor host assets
         correctly (index.html, app.css, _framework/blazor.webview.js, scoped CSS)
         but nothing ever copies them to the output, so BlazorWebView has no host
         page to serve and the window shows "can't reach this page". Verified
         against a pristine template app, so it is the workload, not this project.
         Remove once the workload is fixed upstream. -->
    <Target Name="CopyMauiAssetsToOutput" AfterTargets="Build"
            DependsOnTargets="ConvertStaticWebAssetsToMauiAssets">
        <Copy SourceFiles="@(MauiAsset)"
              DestinationFiles="@(MauiAsset->'$(OutDir)%(TargetPath)')"
              SkipUnchangedFiles="true"
              Condition="'%(MauiAsset.TargetPath)' != ''" />
    </Target>

    <!-- Same bug, publish side: without this the signed MSIX ships without a host
         page and the installed app shows "can't reach this page". -->
    <Target Name="CopyMauiAssetsToPublish" AfterTargets="ComputeResolvedFilesToPublishList"
            DependsOnTargets="ConvertStaticWebAssetsToMauiAssets">
        <ItemGroup>
            <ResolvedFileToPublish Include="@(MauiAsset)"
                                   RelativePath="%(MauiAsset.TargetPath)"
                                   CopyToPublishDirectory="PreserveNewest"
                                   Condition="'%(MauiAsset.TargetPath)' != ''" />
        </ItemGroup>
    </Target>

</Project>
