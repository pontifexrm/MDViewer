@page "/"
@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop
@implements IDisposable
@inject IDocumentPrinter Printer
@inject IFileDialogs Dialogs
@inject ILinkOpener Links
@inject IJSRuntime JS

<div class="app-shell @(_editing ? "mode-edit" : "mode-read")">

    @* ── Toolbar (never printed) ─────────────────────────────────────────── *@
    <div class="toolbar no-print">
        <button class="tb" @onclick="OpenAsync" title="Open a markdown file or an ePub (Ctrl+O)">
            <span class="ic">&#128193;</span>Open
        </button>

        <div class="doc-name" title="@(_file.Path.Length > 0 ? _file.Path : "Not saved yet")">
            @DisplayName
            @if (_dirty)
            {
                <span class="dirty" title="Unsaved changes">&#9679;</span>
            }
        </div>

        <div class="spacer"></div>

        @if (_epub is { } book)
        {
            @* ── ePub: read-only, so chapter navigation replaces the edit controls ── *@
            <button class="tb @(_tocOpen ? "on" : "")" @onclick="() => _tocOpen = !_tocOpen"
                    title="Show or hide the contents">
                <span class="ic">&#9776;</span>Contents
            </button>

            <span class="sep"></span>

            <button class="tb" @onclick="() => GoToChapterAsync(_chapter - 1)"
                    disabled="@(_chapter <= 0)" title="Previous chapter">
                &#8249; Prev
            </button>
            <span class="chapter-count" title="@book.Chapters[_chapter].Title">
                @(_chapter + 1) / @book.Chapters.Count
            </span>
            <button class="tb" @onclick="() => GoToChapterAsync(_chapter + 1)"
                    disabled="@(_chapter >= book.Chapters.Count - 1)" title="Next chapter">
                Next &#8250;
            </button>
        }
        else
        {
            <button class="tb @(_editing ? "on" : "")" @onclick="ToggleEdit"
                    title="@(_editing ? "Back to reading view" : "Edit the markdown source")">
                <span class="ic">@(_editing ? "\U0001F441" : "✎")</span>@(_editing ? "Read" : "Edit")
            </button>

            @if (_editing)
            {
                <button class="tb" @onclick="SaveAsync" disabled="@(!_dirty || _file.Path.Length == 0)"
                        title="Save back to the original file (Ctrl+S)">
                    <span class="ic">&#128190;</span>Save
                </button>
                <button class="tb" @onclick="SaveAsMarkdownAsync" title="Save to a new .md file">
                    Save As…
                </button>
            }
        }

        <span class="sep"></span>

        <button class="tb" @onclick="PrintAsync" disabled="@(!_hasDocument)"
                title="@(_epub is null ? "Print preview (also offers Save as PDF)" : "Print preview of this chapter")">
            <span class="ic">&#128424;</span>Print
        </button>
        <button class="tb" @onclick="ExportPdfAsync" disabled="@(!_hasDocument)"
                title="@(_epub is null ? "Write a PDF next to the source file" : "Write this chapter to a PDF next to the book")">
            PDF
        </button>

        @if (_epub is null)
        {
            <button class="tb" @onclick="ExportWordAsync" disabled="@(!_hasDocument)" title="Write a Word document next to the source file">
                Word
            </button>
            <button class="tb" @onclick="ExportEpubAsync" disabled="@(!_hasDocument)" title="Write an ePub next to the source file">
                ePub
            </button>
        }
    </div>

    @* ── Rewritten underneath us (markdown only; see WatchAsync) ─────────── *@
    @if (_diskChanged)
    {
        <div class="status disk no-print">
            <span>This file has changed on disk.</span>
            <button class="link" @onclick="ReloadAsync">Reload</button>
            <button class="link dismiss" @onclick="DismissDiskChange">&#10005;</button>
        </div>
    }

    @* ── Status line ─────────────────────────────────────────────────────── *@
    @if (_status is not null)
    {
        <div class="status no-print @(_statusIsError ? "err" : "")">
            <span>@_status</span>
            @if (_statusPath is not null)
            {
                <button class="link" @onclick="() => ExportPaths.Reveal(_statusPath!)">Show in folder</button>
            }
            <button class="link dismiss" @onclick="ClearStatus">&#10005;</button>
        </div>
    }

    @* ── Content ─────────────────────────────────────────────────────────── *@
    <div class="content">

        @if (_editing)
        {
            <textarea class="md-source no-print" spellcheck="false"
                      value="@_source"
                      @oninput="OnSourceInput"
                      @onkeydown="OnSourceKeyDown"></textarea>
        }

        @if (_epub is { } toc && _tocOpen)
        {
            <nav class="toc no-print">
                <div class="toc-head">Contents</div>
                <ol>
                    @foreach (var entry in toc.Contents)
                    {
                        <li class="depth-@Math.Min(entry.Depth, 3) @(entry.ChapterIndex == _chapter ? "cur" : "")">
                            <button @onclick="() => GoToChapterAsync(entry.ChapterIndex, entry.Fragment)">
                                @entry.Title
                            </button>
                        </li>
                    }
                </ol>
            </nav>
        }

        <div class="doc-pane">
            @if (_hasDocument)
            {
                <article class="doc-render @(_epub is null ? "" : "book")">
                    @((MarkupString)(_epub is null ? ScreenHtml : _html))
                </article>
            }
            else
            {
                <div class="empty no-print">
                    <h1>Markdown Viewer</h1>
                    <p>
                        Open a <code>.md</code> file or an <code>.epub</code> book, or make this app
                        the default handler and just double-click one.
                    </p>
                    <button class="tb primary" @onclick="OpenAsync">Open a file…</button>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private MarkdownFile _file = MarkdownFile.Untitled();
    private string _source = string.Empty;
    private string _html = string.Empty;
    private bool _editing;
    private bool _dirty;

    // ── ePub state. Null in markdown mode, which is what every "is this a book?"
    // check in the markup keys off. ──────────────────────────────────────────
    private EpubDocument? _epub;
    private int _chapter;
    private bool _tocOpen = true;

    // ── Watching the file on disk. Markdown only: a book being rewritten while
    // it is open is not a thing that happens. ────────────────────────────────
    private CancellationTokenSource? _watchCts;
    private bool _diskChanged;
    private FileStamp? _dismissedStamp;

    /// <summary>How often the open file is stamped. Two ticks are needed to act on a
    /// change, so an edit surfaces within roughly two of these.</summary>
    private static readonly TimeSpan PollInterval = TimeSpan.FromSeconds(1.5);

    private DotNetObjectReference<Viewer>? _selfRef;
    private string? _revealFragment;
    private int? _revealBlock;
    private double _revealFraction;
    private bool _revealPending;

    private string? _status;
    private string? _statusPath;
    private bool _statusIsError;

    // Re-rendering on every keystroke is wasteful on a long document, so the
    // preview lags the caret by a beat instead.
    private CancellationTokenSource? _previewDebounce;

    private bool _hasDocument => _html.Length > 0 || _epub is not null;

    // The on-screen HTML carries source-line tags the exports must not, so it is a
    // second render, redone only when _html itself is replaced.
    private string? _screenFor;
    private string _screenHtml = string.Empty;

    private string ScreenHtml
    {
        get
        {
            if (!ReferenceEquals(_screenFor, _html))
            {
                _screenFor = _html;
                _screenHtml = MarkdownRenderer.ForScreen(_source);
            }
            return _screenHtml;
        }
    }

    private string DisplayName => _epub is { } book
        ? book.Title
        : _file.Path.Length > 0
            ? Path.GetFileName(_file.Path)
            : (_hasDocument ? "Untitled" : "No file open");

    /// <summary>Title used for the ePub/Word exports and their filenames.</summary>
    private string DocumentTitle =>
        _epub?.Title
        ?? MarkdownRenderer.LeadingTitle(_source)
        ?? (_file.Path.Length > 0 ? Path.GetFileNameWithoutExtension(_file.Path) : "Untitled");

    /// <summary>True when the markdown already opens with its own H1.</summary>
    private bool HasOwnTitle => MarkdownRenderer.LeadingTitle(_source) is not null;

    protected override async Task OnInitializedAsync()
    {
        // The file the app was launched with, parked by MDViewer/Platforms/Windows/App.xaml.cs.
        if (PendingFile.Take() is { Length: > 0 } path)
            await LoadAsync(path);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _selfRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("mdvEpub.attach", _selfRef);
            await JS.InvokeVoidAsync("mdvPaste.attach", _selfRef);
            await JS.InvokeVoidAsync("mdvTasks.attach", _selfRef);
        }

        // Scrolling has to wait until the new chapter is actually in the DOM.
        if (_revealPending)
        {
            _revealPending = false;
            var fragment = _revealFragment;
            var block = _revealBlock;
            var fraction = _revealFraction;
            _revealFragment = null;
            _revealBlock = null;
            _revealFraction = 0;
            await JS.InvokeVoidAsync("mdvEpub.reveal", fragment, block, fraction);
        }
    }

    public void Dispose()
    {
        StopWatching();
        _selfRef?.Dispose();
    }

    // ── File operations ──────────────────────────────────────────────────────

    private async Task OpenAsync()
    {
        try
        {
            if (await Dialogs.PickDocumentAsync() is { Length: > 0 } path)
                await LoadAsync(path);
        }
        catch (Exception ex)
        {
            Error($"Couldn't open that file: {ex.Message}");
        }
    }

    private async Task LoadAsync(string path)
    {
        if (Path.GetExtension(path).Equals(".epub", StringComparison.OrdinalIgnoreCase))
        {
            await LoadEpubAsync(path);
            return;
        }

        try
        {
            _file = await MarkdownFile.LoadAsync(path);
            _epub = null;
            _source = _file.Text;
            _html = MarkdownRenderer.ToHtmlString(_source);
            _dirty = false;
            _editing = false;
            _diskChanged = false;
            _dismissedStamp = null;
            ClearStatus();
            StartWatching();
        }
        catch (Exception ex)
        {
            Error($"Couldn't read {Path.GetFileName(path)}: {ex.Message}");
        }
    }

    private async Task LoadEpubAsync(string path)
    {
        try
        {
            var book = await EpubDocument.LoadAsync(path);

            // Clamped, not trusted: the file may have been replaced by a shorter
            // edition since the position was written.
            var resume = ReadingPositions.For(path);
            var start = resume is null ? 0 : Math.Clamp(resume.Chapter, 0, book.Chapters.Count - 1);

            StopWatching();
            _diskChanged = false;
            _dismissedStamp = null;

            _epub = book;
            _chapter = start;
            _tocOpen = book.Contents.Count > 1;
            _html = await book.ChapterHtmlAsync(start);

            // Editing is meaningless for a book, and the exports still want to land
            // beside it — which is all ExportPaths needs the path for.
            _editing = false;
            _dirty = false;
            _source = string.Empty;
            _file = MarkdownFile.Untitled().At(path);

            _revealFragment = null;
            _revealBlock = resume?.Block;
            _revealFraction = resume?.Fraction ?? 0;
            _revealPending = true;

            if (resume is not null && (start > 0 || resume.Block > 0))
                Info($"Picked up where you left off — {book.Chapters[start].Title}");
            else
                ClearStatus();
        }
        catch (Exception ex)
        {
            _epub = null;
            Error($"Couldn't read {Path.GetFileName(path)}: {ex.Message}");
        }
    }

    private async Task SaveAsync()
    {
        if (!_dirty || _file.Path.Length == 0) return;

        try
        {
            await _file.SaveAsync(_source);
            _dirty = false;
            Info($"Saved {Path.GetFileName(_file.Path)}");
        }
        catch (Exception ex)
        {
            Error($"Couldn't save: {ex.Message}");
        }
    }

    private async Task SaveAsMarkdownAsync()
    {
        try
        {
            var suggested = _file.Path.Length > 0
                ? Path.GetFileNameWithoutExtension(_file.Path)
                : ExportPaths.Sanitize(DocumentTitle);

            if (await Dialogs.SaveAsAsync(suggested, ".md", "Markdown") is not { Length: > 0 } path)
                return;

            await _file.SaveAsync(_source, path);
            _file = _file.At(path);
            _dirty = false;
            _diskChanged = false;
            _dismissedStamp = null;
            StartWatching();
            Info($"Saved {Path.GetFileName(path)}", path);
        }
        catch (Exception ex)
        {
            Error($"Couldn't save: {ex.Message}");
        }
    }

    // ── Watching the file on disk ────────────────────────────────────────────

    /// <summary>
    /// Starts polling the open markdown file, replacing any watch already running.
    /// Polling rather than a FileSystemWatcher on purpose: editors save by writing a
    /// temp file and renaming it over the target, which the watcher reports as two or
    /// three separate events — and sometimes reports before the new contents are
    /// there. A stamp compared on a timer sidesteps all of that.
    /// </summary>
    private void StartWatching()
    {
        StopWatching();
        if (_epub is not null || _file.Path.Length == 0) return;

        var cts = new CancellationTokenSource();
        _watchCts = cts;
        _ = WatchAsync(_file.Path, cts.Token);
    }

    private void StopWatching()
    {
        _watchCts?.Cancel();
        _watchCts?.Dispose();
        _watchCts = null;
    }

    private async Task WatchAsync(string path, CancellationToken token)
    {
        using var timer = new PeriodicTimer(PollInterval);
        FileStamp? previous = null;

        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                var stamp = FileStamp.Of(path);

                // Null means gone or unreadable mid-write: say nothing and look again.
                // Acting only on a stamp seen twice running keeps the app from reading
                // a file a writer is still part-way through.
                var settled = stamp is not null && stamp == previous;
                previous = stamp;
                if (!settled) continue;

                await InvokeAsync(async () =>
                {
                    // The document may have been closed or replaced while this tick
                    // was in flight, in which case the change is no longer ours.
                    if (token.IsCancellationRequested) return;
                    if (_epub is not null || _file.Path != path) return;
                    if (stamp == _file.Stamp || stamp == _dismissedStamp) return;

                    // Unsaved edits, or a caret sitting in the textarea: offer the
                    // reload rather than taking it. Overwriting either without asking
                    // would be destroying work the app was trusted with.
                    if (_dirty || _editing)
                    {
                        _diskChanged = true;
                    }
                    else
                    {
                        // Announced: the document is about to change under the
                        // reader's eyes, and unexplained movement reads as a bug.
                        await ReloadFromDiskAsync(announce: true);
                    }

                    StateHasChanged();
                });
            }
        }
        catch (Exception ex) when (ex is OperationCanceledException or ObjectDisposedException)
        {
            // The file was closed, or the window went away with a tick in flight.
            // Either way there is nothing left to watch.
        }
    }

    /// <summary>The Reload button on the changed-on-disk bar.</summary>
    private async Task ReloadAsync()
    {
        _diskChanged = false;
        await ReloadFromDiskAsync();
    }

    private void DismissDiskChange()
    {
        // Remembered so the same change does not immediately raise the bar again;
        // a later edit produces a different stamp and does.
        _dismissedStamp = FileStamp.Of(_file.Path);
        _diskChanged = false;
    }

    /// <summary>
    /// Re-reads the open file and puts the reader back where they were. The position
    /// is a block index rather than a scroll offset — the same measure the ePub
    /// reader resumes from — so it still points at the right paragraph even though
    /// the text above it may have grown or shrunk.
    /// </summary>
    private async Task ReloadFromDiskAsync(bool announce = false)
    {
        if (_file.Path.Length == 0) return;

        var at = await CurrentPositionAsync();

        try
        {
            var reloaded = await ReadWithRetryAsync(_file.Path);

            _file = reloaded;
            _source = reloaded.Text;
            _html = MarkdownRenderer.ToHtmlString(_source);
            _dirty = false;
            _dismissedStamp = null;

            _revealFragment = null;
            _revealBlock = at?.Block;
            _revealFraction = at?.Fraction ?? 0;
            _revealPending = true;

            if (announce)
                Info($"Reloaded — {Path.GetFileName(_file.Path)} changed on disk");
            else
                ClearStatus();
        }
        catch (Exception ex)
        {
            // The on-screen document is still the last good one, so this is a notice
            // rather than a failure: nothing has been lost.
            Error($"Couldn't reload {Path.GetFileName(_file.Path)}: {ex.Message}");
            _diskChanged = true;
        }
    }

    /// <summary>
    /// A read that tolerates arriving while a writer still holds the file. The stamp
    /// has settled by the time this runs, so a lock here is the tail of a slow save
    /// rather than a lasting condition.
    /// </summary>
    private static async Task<MarkdownFile> ReadWithRetryAsync(string path)
    {
        for (var attempt = 1; ; attempt++)
        {
            try
            {
                return await MarkdownFile.LoadAsync(path);
            }
            catch (IOException) when (attempt < 3)
            {
                await Task.Delay(150);
            }
        }
    }

    private async Task<ScrollPoint?> CurrentPositionAsync()
    {
        try
        {
            return await JS.InvokeAsync<ScrollPoint?>("mdvEpub.position");
        }
        catch (Exception)
        {
            // Losing the scroll position is not a reason to refuse the reload.
            return null;
        }
    }

    /// <summary>What wwwroot/epub.js reports for the top of the viewport.</summary>
    private sealed record ScrollPoint(int Block, double Fraction);

    // ── Reading an ePub ──────────────────────────────────────────────────────

    private async Task GoToChapterAsync(int index, string? fragment = null)
    {
        if (_epub is not { } book) return;
        if (index < 0 || index >= book.Chapters.Count) return;

        try
        {
            _html = await book.ChapterHtmlAsync(index);
            _chapter = index;
            _revealFragment = fragment;
            _revealBlock = null;
            _revealFraction = 0;
            _revealPending = true;
            ClearStatus();

            // Recorded now rather than waiting for the scroll that follows, so
            // closing the window straight after turning a chapter still remembers it.
            await ReadingPositions.SaveAsync(_file.Path, index, 0, 0);
        }
        catch (Exception ex)
        {
            Error($"Couldn't read that chapter: {ex.Message}");
        }
    }

    /// <summary>
    /// Called from wwwroot/epub.js on a debounced scroll. Writes straight through to
    /// disk instead of waiting for the window to close, which would lose the position
    /// if the app were killed. No StateHasChanged — nothing on screen changes.
    /// </summary>
    [JSInvokable]
    public async Task EpubScrolled(int block, double fraction)
    {
        if (_epub is null || _file.Path.Length == 0) return;
        await ReadingPositions.SaveAsync(_file.Path, _chapter, block, fraction);
    }

    /// <summary>Called from wwwroot/epub.js for a link into another chapter.</summary>
    [JSInvokable]
    public Task EpubLinkClicked(int chapter, string fragment) =>
        InvokeAsync(async () =>
        {
            await GoToChapterAsync(chapter, fragment.Length == 0 ? null : fragment);
            StateHasChanged();
        });

    /// <summary>
    /// Called from wwwroot/epub.js for a link out to the web. The scheme is checked
    /// again here rather than trusted from the DOM: this ends in a shell launch, and
    /// the URL came out of a file the app did not write.
    /// </summary>
    [JSInvokable]
    public async Task EpubExternalClicked(string url)
    {
        if (!Uri.TryCreate(url, UriKind.Absolute, out var uri)) return;
        if (uri.Scheme is not ("http" or "https")) return;

        try
        {
            await Links.OpenAsync(uri);
        }
        catch (Exception ex)
        {
            await InvokeAsync(() =>
            {
                Error($"Couldn't open that link: {ex.Message}");
                StateHasChanged();
            });
        }
    }

    // ── Editing ──────────────────────────────────────────────────────────────

    private void ToggleEdit()
    {
        _editing = !_editing;
        ClearStatus();
    }

    private async Task OnSourceInput(ChangeEventArgs e)
    {
        _source = e.Value?.ToString() ?? string.Empty;
        _dirty = _source != _file.Text;

        _previewDebounce?.Cancel();
        _previewDebounce = new CancellationTokenSource();
        var token = _previewDebounce.Token;

        try
        {
            await Task.Delay(200, token);
            _html = MarkdownRenderer.ToHtmlString(_source);
            StateHasChanged();
        }
        catch (TaskCanceledException)
        {
            // Superseded by a later keystroke — the newer render will land instead.
        }
    }

    private async Task OnSourceKeyDown(KeyboardEventArgs e)
    {
        if (e.CtrlKey && e.Key.Equals("s", StringComparison.OrdinalIgnoreCase))
            await SaveAsync();
    }

    /// <summary>
    /// Called from wwwroot/paste.js with the HTML version of what is being pasted.
    /// Null means "paste the plain text instead" — either there was nothing worth
    /// converting or the conversion failed, and neither is a reason to lose a paste.
    /// The text itself goes in from the JS side, as an input event like any other.
    /// </summary>
    [JSInvokable]
    public async Task<string?> ConvertPaste(string html)
    {
        PastedMarkdown? pasted;
        try
        {
            pasted = HtmlToMarkdown.Convert(html);
        }
        catch (Exception)
        {
            return null;
        }

        if (pasted is null) return null;

        await InvokeAsync(() =>
        {
            var dropped = pasted.ImagesDropped switch
            {
                0 => "",
                1 => " 1 image was left out.",
                var n => $" {n} images were left out.",
            };
            Info($"Pasted as markdown — Ctrl+Z undoes it, Ctrl+Shift+V pastes plain text.{dropped}");
            StateHasChanged();
        });
        return pasted.Markdown;
    }

    // ── Task lists ───────────────────────────────────────────────────────────

    /// <summary>
    /// Called from wwwroot/tasks.js when a task-list checkbox is clicked. In the
    /// reading view of a saved, unedited file the change goes straight to disk — a
    /// to-do list should not need a Save. With an edit in progress it joins that
    /// edit instead, since saving now would also save the half-finished rest.
    /// </summary>
    [JSInvokable]
    public Task TaskClicked(int index, bool wasChecked) =>
        InvokeAsync(async () =>
        {
            if (_epub is not null) return;

            if (MarkdownRenderer.ToggleTask(_source, index, wasChecked) is not { } toggled)
            {
                // The page and the source disagree; re-rendering puts the box back.
                StateHasChanged();
                return;
            }

            var saveNow = !_dirty && !_editing && _file.Path.Length > 0;

            // Something else has rewritten the file since it was read. Writing now
            // would quietly throw that away, so it is offered as a reload instead.
            if (saveNow && FileStamp.Of(_file.Path) != _file.Stamp)
            {
                _diskChanged = true;
                Error("Not saved — this file has changed on disk. Reload, then tick it again.");
                StateHasChanged();
                return;
            }

            _source = toggled;
            _html = MarkdownRenderer.ToHtmlString(_source);

            if (saveNow)
            {
                try
                {
                    await _file.SaveAsync(_source);
                    ClearStatus();
                }
                catch (Exception ex)
                {
                    _dirty = true;
                    Error($"Couldn't save: {ex.Message}");
                }
            }
            else
            {
                _dirty = _source != _file.Text;
            }

            StateHasChanged();
        });

    // ── Output ───────────────────────────────────────────────────────────────

    private async Task PrintAsync()
    {
        if (!Printer.IsReady) { Error("The print engine isn't ready yet — try again in a moment."); return; }
        await Printer.ShowPrintDialogAsync();
    }

    private async Task ExportPdfAsync()
    {
        if (!Printer.IsReady) { Error("The print engine isn't ready yet — try again in a moment."); return; }

        var target = ExportPaths.For(NullIfEmpty(_file.Path), DocumentTitle, ".pdf");
        try
        {
            if (await Printer.PrintToPdfAsync(target))
                Info($"PDF written to {Path.GetFileName(target)}", target);
            else
                Error("WebView2 declined to produce the PDF.");
        }
        catch (Exception ex)
        {
            Error($"Couldn't write the PDF: {ex.Message}");
        }
    }

    private async Task ExportWordAsync()
    {
        var target = ExportPaths.For(NullIfEmpty(_file.Path), DocumentTitle, ".doc");
        try
        {
            var bytes = WordExporter.ToDoc(DocumentTitle, _html, includeTitleHeading: !HasOwnTitle);
            await File.WriteAllBytesAsync(target, bytes);
            Info($"Word document written to {Path.GetFileName(target)}", target);
        }
        catch (Exception ex)
        {
            Error($"Couldn't write the Word document: {ex.Message}");
        }
    }

    private async Task ExportEpubAsync()
    {
        var target = ExportPaths.For(NullIfEmpty(_file.Path), DocumentTitle, ".epub");
        try
        {
            var bytes = await EpubGenerator.GenerateAsync(DocumentTitle, _html, includeTitleHeading: !HasOwnTitle);
            await File.WriteAllBytesAsync(target, bytes);
            Info($"ePub written to {Path.GetFileName(target)}", target);
        }
        catch (Exception ex)
        {
            Error($"Couldn't write the ePub: {ex.Message}");
        }
    }

    // ── Status helpers ───────────────────────────────────────────────────────

    private static string? NullIfEmpty(string s) => s.Length == 0 ? null : s;

    private void Info(string message, string? path = null)
    {
        _status = message;
        _statusPath = path;
        _statusIsError = false;
    }

    private void Error(string message)
    {
        _status = message;
        _statusPath = null;
        _statusIsError = true;
    }

    private void ClearStatus()
    {
        _status = null;
        _statusPath = null;
        _statusIsError = false;
    }
}
